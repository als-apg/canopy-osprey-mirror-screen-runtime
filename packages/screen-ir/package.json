{
  "name": "@slaclab/canopy-screen-ir",
  "version": "0.1.0",
  "private": false,
  "description": "Canonical Canopy screen Intermediate Representation — types, JSON Schema, and validators",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slaclab/canopy-screen-runtime.git",
    "directory": "packages/screen-ir"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.6"
  }
}
