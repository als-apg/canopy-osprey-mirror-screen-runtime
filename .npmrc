@slaclab:registry=https://npm.pkg.github.com
# authToken line disabled on the fidelity branch: local dev consumes @slaclab/*
# via the pnpm link: overrides in package.json, and an unset NODE_AUTH_TOKEN
# makes pnpm fail config expansion before it even resolves dependencies.
# //npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
